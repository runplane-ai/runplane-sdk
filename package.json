{
  "name": "@runplane/runplane-sdk",
  "version": "1.2.5",
  "description": "Runplane SDK - Control AI agent execution before it runs. Thin wrapper over the Guard API.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "runplane",
    "ai",
    "agent",
    "execution-control",
    "guard",
    "gateway",
    "approval",
    "policy",
    "governance",
    "llm",
    "ai-safety"
  ],
  "author": "Runplane",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/runplane/runplane-sdk.git"
  },
  "homepage": "https://runplane.ai/docs/sdk",
  "bugs": {
    "url": "https://github.com/runplane/runplane-sdk/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "dependencies": {
    "@runplane/runplane-sdk": "^1.2.2"
  }
}
